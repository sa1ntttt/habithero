# ======================================================
# HabitHero — шаблон переменных окружения
# Скопируй этот файл в .env и заполни своими значениями
# НИКОГДА не коммить .env в git!
# ======================================================

# --- Telegram Bot ---
# Токен от @BotFather (вида 1234567890:AAF...)
BOT_TOKEN=your_bot_token_here

# --- База данных PostgreSQL ---
# Для локальной разработки (docker-compose поднимет PostgreSQL)
DATABASE_URL=postgresql+asyncpg://habituser:habitpass@localhost:5432/habitdb

# Для продакшна на Neon (получить на neon.tech после регистрации)
# DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.us-east-2.aws.neon.tech/habitdb?sslmode=require

# --- FastAPI ---
# Секретный ключ для подписи токенов (любая длинная случайная строка)
SECRET_KEY=change_me_to_random_secret_key_at_least_32_chars

# Домен Mini App для CORS (в разработке — localhost)
MINIAPP_URL=http://localhost:5173

# --- Google Gemini AI (для /coach команды) ---
# Получить на aistudio.google.com бесплатно
GEMINI_API_KEY=your_gemini_api_key_here

# --- Настройки приложения ---
# debug = True показывает подробные ошибки (только для разработки!)
DEBUG=True
LOG_LEVEL=INFO

# Окружение: development / production
ENVIRONMENT=development
